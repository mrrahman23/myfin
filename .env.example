# --- Supabase (Project Settings → API keys) -----------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). The legacy anon key also works:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Server-only (never exposed to the browser) ---------------------------------
# Secret key (sb_secret_...) — used by API routes to add family members,
# send push notifications and run the daily reminder job.
SUPABASE_SECRET_KEY=

# --- Push notifications ------------------------------------------------------------
# Generate once:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A URL or mailto: identifying you to push services
VAPID_SUBJECT=https://your-app.vercel.app

# --- Daily cron (Vercel sends "Authorization: Bearer $CRON_SECRET") ----------------
# Any long random string, e.g.  openssl rand -base64 24
CRON_SECRET=
